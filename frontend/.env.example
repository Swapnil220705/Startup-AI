# =============================================================================
# Startup-AI — Frontend Environment Configuration
# =============================================================================
# Copy this file to '.env' (or '.env.production') to configure the React application.
# Note: All variables exposed to the React frontend MUST begin with 'REACT_APP_'.
# Values defined here are embedded into the client JavaScript bundle at build time.
# NEVER include private API secrets, database passwords, or private keys here.
# =============================================================================

# Backend API Base URL
# The origin/URL of the Express backend server.
# Development: Defaults to 'http://localhost:4000' if omitted.
# Production: Set to your public backend domain (e.g. 'https://api.startupai.app')
#             or relative empty string / '/api' if frontend and backend share an origin / reverse proxy.
REACT_APP_API_BASE_URL=http://localhost:4000

# Google OAuth 2.0 Web Client ID
# Created in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Required for the "Continue with Google" sign-in button in AuthModal.
# If omitted or left empty, Google Sign-In displays a graceful setup notice,
# and users can continue registering and signing in via Email/Password.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
